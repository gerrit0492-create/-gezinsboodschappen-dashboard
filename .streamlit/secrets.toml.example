# COPY THE VALUES INTO STREAMLIT CLOUD -> APP SETTINGS -> SECRETS.
# NEVER COMMIT A REAL secrets.toml TO GITHUB. No service-account key is needed.

# Only these Google accounts get access (deny by default). Use the exact login e-mail addresses.
# Each of them must also be allowed to edit the Google Sheet (Share -> Editor).
ALLOWED_EMAILS = ["first.person@example.com", "second.person@example.com"]

SHEET_ID = "your-private-google-sheet-id"

# Google login (Streamlit built-in OIDC). redirect_uri must be the app URL + /oauth2callback and must
# also be listed under "Authorized redirect URIs" of the Google OAuth client.
# The app reads/writes the Sheet with the logged-in user's own access token: expose it and request the
# Google Sheets scope in addition to the login scopes.
[auth]
redirect_uri = "https://your-app-name.streamlit.app/oauth2callback"
cookie_secret = "a-long-random-string-of-at-least-32-characters"
client_id = "your-oauth-client-id.apps.googleusercontent.com"
client_secret = "your-oauth-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
expose_tokens = "access"
client_kwargs = { scope = "openid email profile https://www.googleapis.com/auth/spreadsheets" }
